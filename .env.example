# BeautyChem AI: баптаулар үлгісі.
# Бұл файлды ".env" деп көшіріп алыңыз (cp .env.example .env) және мәндерін толтырыңыз.
# .env файлын ЕШҚАШАН интернетке (GitHub-қа) жүктемеңіз: онда құпия кілт болады.

# --- Gemini API кілті (МІНДЕТТІ: AI тану, OCR, интернеттен құрам іздеу, қазақша қорытынды) ---
# Тегін кілтті мына жерден алуға болады: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Қолданылатын модель (суретті түсінетін Gemini моделі болуы керек)
GEMINI_MODEL=gemini-2.5-flash

# --- Сервер ---
PORT=3001

# --- Қосымша (міндетті емес) ---
# Дерекқор файлының жолы (жоба түбіріне қатысты). Әдепкі: database/beautychem.db
# DATABASE_PATH=database/beautychem.db

# Жергілікті HTTPS (мысалы mkcert сертификаттарымен). Екеуін де толтырсаңыз, сервер https://-пен іске қосылады
# SSL_KEY_PATH=certs/localhost-key.pem
# SSL_CERT_PATH=certs/localhost.pem
